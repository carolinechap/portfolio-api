<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="x-apple-disable-message-reformatting">
  <meta name="color-scheme" content="dark light">
  <meta name="supported-color-schemes" content="dark light">
  <title>Nouveau message reçu</title>
  <!--[if mso]>
  <noscript><xml><o:OfficeDocumentSettings><o:PixelsPerInch>96</o:PixelsPerInch></o:OfficeDocumentSettings></xml></noscript>
  <![endif]-->
</head>
<body style="margin:0;padding:0;background-color:#0a0a0f;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;color:#f5f6fa;-webkit-font-smoothing:antialiased;">

  {# Preheader — texte d'aperçu masqué #}
  <div style="display:none;max-height:0;overflow:hidden;font-size:1px;line-height:1px;color:#0a0a0f;opacity:0;">
    Nouveau message de {{ contact.firstname }} via caroline-chapeau.com — {{ contact.message|slice(0, 80) }}…
  </div>

  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"
         style="background-color:#0a0a0f;padding:32px 16px;">
    <tr>
      <td align="center">

        <!-- ========= Container ========= -->
        <table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0"
               style="max-width:600px;width:100%;background-color:#11111a;border:1px solid #1c1d27;border-radius:16px;overflow:hidden;">

          <!-- Gradient bar -->
          <tr>
            <td style="height:4px;background:linear-gradient(90deg,#7c5cfc 0%,#00d4ff 100%);font-size:0;line-height:0;">&nbsp;</td>
          </tr>

          <!-- Header -->
          <tr>
            <td style="padding:28px 32px 0;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                <tr>
                  <td style="vertical-align:middle;">
                    <table role="presentation" cellpadding="0" cellspacing="0" border="0">
                      <tr>
                        <td style="width:36px;height:36px;background:linear-gradient(135deg,#7c5cfc,#00d4ff);border-radius:8px;text-align:center;vertical-align:middle;font-family:-apple-system,Helvetica,Arial,sans-serif;font-weight:700;font-size:14px;color:#0a0a0f;letter-spacing:-0.02em;">CC</td>
                        <td style="padding-left:12px;font-family:'SF Mono',Menlo,Consolas,monospace;font-size:13px;color:#f5f6fa;">caroline<span style="color:#7c5cfc;">.dev</span></td>
                      </tr>
                    </table>
                  </td>
                  <td align="right" style="font-family:'SF Mono',Menlo,Consolas,monospace;font-size:10px;color:#6e7282;letter-spacing:0.1em;text-transform:uppercase;">
                    // new_message
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- Title block -->
          <tr>
            <td style="padding:24px 32px 8px;">
              <div style="font-family:'SF Mono',Menlo,Consolas,monospace;font-size:11px;color:#7c5cfc;letter-spacing:0.08em;text-transform:uppercase;margin-bottom:10px;">
                ● Message reçu
              </div>
              <h1 style="margin:0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;font-size:30px;font-weight:600;line-height:1.1;letter-spacing:-0.04em;color:#f5f6fa;">
                Quelqu'un veut <span style="font-family:'Iowan Old Style','Times New Roman',Georgia,serif;font-style:italic;font-weight:400;color:#00d4ff;">construire</span> avec toi
              </h1>
              <p style="margin:12px 0 0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;font-size:14px;line-height:1.5;color:#c4c6d0;">
                Reçu via le formulaire de contact de caroline-chapeau.com{% if submittedAt %} — {{ submittedAt|date('d/m/Y à H:i') }}{% endif %}.
              </p>
            </td>
          </tr>

          <!-- Sender card -->
          <tr>
            <td style="padding:24px 32px 0;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"
                     style="background-color:#0d0d14;border:1px solid #1c1d27;border-radius:12px;">
                <tr>
                  <td style="padding:18px 20px;">
                    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                      <tr>
                        <td style="font-family:'SF Mono',Menlo,Consolas,monospace;font-size:10px;color:#6e7282;letter-spacing:0.1em;text-transform:uppercase;padding-bottom:8px;">
                          De
                        </td>
                      </tr>
                      <tr>
                        <td style="font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;font-size:18px;font-weight:600;color:#f5f6fa;letter-spacing:-0.02em;line-height:1.2;padding-bottom:4px;">
                          {{ contact.name }}
                        </td>
                      </tr>
                      <tr>
                        <td style="font-family:'SF Mono',Menlo,Consolas,monospace;font-size:13px;color:#c4c6d0;">
                          <a href="mailto:{{ contact.email }}" style="color:#00d4ff;text-decoration:none;">{{ contact.email }}</a>
                        </td>
                      </tr>
                      {% if contact.phone %}
                        <tr>
                          <td style="font-family:'SF Mono',Menlo,Consolas,monospace;font-size:13px;color:#c4c6d0;padding-top:6px;">
                            <a href="tel:{{ contact.phone }}" style="color:#c4c6d0;text-decoration:none;">{{ contact.phone }}</a>
                          </td>
                        </tr>
                      {% endif %}
                      {% if contact.opportunity or contact.company %}
                        <tr>
                          <td style="padding-top:12px;">
                            {% if contact.opportunity %}
                              <span style="display:inline-block;font-family:'SF Mono',Menlo,Consolas,monospace;font-size:10.5px;padding:4px 10px;background:rgba(124,92,252,0.18);border:1px solid rgba(124,92,252,0.5);border-radius:999px;color:#f5f6fa;letter-spacing:0.02em;margin-right:4px;margin-bottom:4px;">
                                {{ contact.opportunity }}
                              </span>
                            {% endif %}
                            {% if contact.company %}
                              <span style="display:inline-block;font-family:'SF Mono',Menlo,Consolas,monospace;font-size:10.5px;padding:4px 10px;background:#11111a;border:1px solid #1c1d27;border-radius:999px;color:#c4c6d0;letter-spacing:0.02em;">
                                {{ contact.company }}
                              </span>
                            {% endif %}
                          </td>
                        </tr>
                      {% endif %}
                    </table>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- Message block -->
          <tr>
            <td style="padding:20px 32px 0;">
              <div style="font-family:'SF Mono',Menlo,Consolas,monospace;font-size:10px;color:#6e7282;letter-spacing:0.1em;text-transform:uppercase;margin-bottom:10px;">
                Message
              </div>
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"
                     style="background:linear-gradient(180deg,rgba(124,92,252,0.06) 0%,#0d0d14 100%);border:1px solid #1c1d27;border-left:3px solid #7c5cfc;border-radius:10px;">
                <tr>
                  <td style="padding:22px 24px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;font-size:15px;line-height:1.65;color:#f5f6fa;letter-spacing:-0.008em;white-space:pre-wrap;">{{ contact.message|nl2br }}</td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- CTA -->
          <tr>
            <td style="padding:28px 32px 8px;">
              <table role="presentation" cellpadding="0" cellspacing="0" border="0">
                <tr>
                  <td style="background-color:#f5f6fa;border-radius:999px;">
                    <a href="mailto:{{ contact.email }}?subject=Re%3A%20{{ contact.name|url_encode }}"
                       style="display:inline-block;padding:14px 24px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;font-size:14px;font-weight:500;color:#0a0a0f;text-decoration:none;letter-spacing:-0.01em;">
                      Répondre à {{ contact.name }} →
                    </a>
                  </td>
                  <td style="width:10px;font-size:0;line-height:0;">&nbsp;</td>
                  <td style="border:1px solid #1c1d27;border-radius:999px;">
                    <a href="mailto:{{ contact.email }}"
                       style="display:inline-block;padding:13px 22px;font-family:'SF Mono',Menlo,Consolas,monospace;font-size:12px;color:#c4c6d0;text-decoration:none;letter-spacing:0.04em;text-transform:uppercase;">
                      Copier l'email
                    </a>
                  </td>
                </tr>
              </table>
            </td>
          </tr>
          <!-- Footer -->
          <tr>
            <td style="padding:24px 32px 28px;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"
                     style="border-top:1px solid #1c1d27;padding-top:18px;">
                <tr>
                  <td style="font-family:'SF Mono',Menlo,Consolas,monospace;font-size:10px;color:#6e7282;letter-spacing:0.04em;line-height:1.5;">
                    © Caroline Chapeau · Lyon, FR<br>
                    <a href="{{ siteUrl|default('https://caroline-chapeau.com') }}" style="color:#6e7282;text-decoration:underline;">caroline-chapeau.com</a>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

        </table>
        <!-- ========= End container ========= -->

        <!-- Outer meta -->
        <table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0"
               style="max-width:600px;width:100%;margin-top:18px;">
          <tr>
            <td align="center" style="font-family:'SF Mono',Menlo,Consolas,monospace;font-size:10px;color:#6e7282;letter-spacing:0.04em;line-height:1.5;">
              Tu reçois cet email car quelqu'un a soumis le formulaire de contact de ton portfolio.
            </td>
          </tr>
        </table>

      </td>
    </tr>
  </table>
</body>
</html>
